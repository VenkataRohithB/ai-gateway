# Copy to .env and fill in, or generate everything with: scripts/gen-env.sh
# Existing .env missing newer variables?            scripts/gen-env.sh --add-missing
POSTGRES_USER=gateway                 # bootstrap superuser; no service uses it after setup
POSTGRES_PASSWORD=change-me
LITELLM_MASTER_KEY=sk-change-me       # LiteLLM admin; never given to the gateway or agents
# Must stay stable across restarts: LiteLLM encrypts stored credentials with it.
LITELLM_SALT_KEY=sk-change-me
LITELLM_DB_PASSWORD=change-me         # role litellm_app
GATEWAY_OWNER_PASSWORD=change-me      # role gateway_owner (migrations only)
GATEWAY_APP_PASSWORD=change-me        # role gateway_app (gateway runtime)
LITELLM_GATEWAY_KEY=sk-gw-change-me   # scoped LiteLLM key the gateway uses
ADMIN_TOKEN=adm_change-me             # gateway admin API / dashboard
GEMINI_API_KEY=
